# Copiez ce fichier en .env.local puis remplacez les valeurs.
# Supabase > Project Settings > API Keys (clé « publishable », jamais la clé secrète)
NEXT_PUBLIC_SUPABASE_URL=https://votre-projet.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxxxxxxxxxxxxxxx

# URL publique du site (utilisée pour les métadonnées et les liens de partage)
NEXT_PUBLIC_SITE_URL=http://localhost:3000
